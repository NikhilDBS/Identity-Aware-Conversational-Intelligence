# ── LLM (via LiteLLM — swap to any supported provider) ────────────────────────
LITELLM_MODEL=mistral/mistral-medium-3
MISTRAL_API_KEY=your_mistral_api_key_here

# ── Neo4j (local instance — no Docker) ────────────────────────────────────────
# Set up Neo4j Desktop or Community Server first, then:
#   1. Open Neo4j Browser at http://localhost:7474
#   2. Change the default password from "neo4j" to something of your choice
#   3. Fill NEO4J_PASSWORD below
#   4. Run: python scripts/init_schema.py  (once, to create constraints)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ── MCP Server ─────────────────────────────────────────────────────────────────
# Must be false — the agent needs to write memories, not just read
NEO4J_READ_ONLY=false
